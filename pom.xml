<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.Blank</groupId>
    <artifactId>ImageCloud</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ImageCloud</name>
    <description>ImageCloud</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- Spring Boot 的 Spring Data Redis 启动器，用于自动配置 Lettuce 客户端并访问 Redis。
             官方文档 https://docs.spring.io/spring-boot/3.5/reference/data/nosql.html#data.nosql.redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Spring Boot Web 启动器，使用 Spring MVC 提供 REST 接口并处理 HTTP 请求。
             官方文档 https://docs.spring.io/spring-boot/3.5/reference/web/servlet.html#web.servlet.spring-mvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation 启动器，用于校验注册请求字段。
             官方文档 https://docs.spring.io/spring-boot/3.5/reference/io/validation.html -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Security Crypto 提供密码哈希与校验组件，由 Spring Boot 管理版本。
             官方文档 https://docs.spring.io/spring-security/reference/6.5/features/authentication/password-storage.html -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Security OAuth2 JOSE 提供 RS256 JWT 签发组件。
             官方文档 https://docs.spring.io/spring-security/reference/6.5/api/java/org/springframework/security/oauth2/jwt/NimbusJwtEncoder.html -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- Spring Boot AOP 启动器，提供 Spring AOP 和 AspectJ 注解支持，用于定义作用于 Spring Bean 的切面。
             官方文档 https://docs.spring.io/spring-boot/3.5/reference/features/aop.html -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- springdoc-openapi 的 Spring MVC 启动器，用于生成 OpenAPI 3 接口描述并提供 Swagger UI。
             官方文档 https://springdoc.org/#getting-started -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.10.0</version>
        </dependency>

        <!-- Knife4j 的 OpenAPI 3 前端组件，用于在 /doc.html 浏览和调试接口。
             官方文档 https://doc.xiaominfo.com/docs/upgrading/upgrading-to-v4 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-ui</artifactId>
            <version>4.5.0</version>
        </dependency>

        <!-- MyBatis-Plus 的 Spring Boot 3 启动器，用于配置数据访问层，提供 Mapper、CRUD 和条件查询。
             官方文档 https://baomidou.com/getting-started/ -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.18</version>
        </dependency>

        <!-- MyBatis-Plus JSqlParser 模块，提供分页拦截器及分页 SQL 解析，版本与现有启动器一致。
             官方文档 https://baomidou.com/plugins/pagination/ -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.18</version>
        </dependency>

        <!-- MySQL Connector/J 是 MySQL 的 JDBC 驱动，用于在运行时从 Java 连接 MySQL。
             官方文档 https://dev.mysql.com/doc/connector-j/en/connector-j-installing-maven.html -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Project Lombok 提供编译期注解，用于生成访问器、构造方法等样板代码。
             官方文档 https://projectlombok.org/setup/maven -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot 测试启动器，提供 Spring 测试支持、JUnit Jupiter 和 AssertJ 等工具。
             官方文档 https://docs.spring.io/spring-boot/3.5/reference/testing/index.html -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 腾讯云 COS Java SDK，用于创建 COS 客户端并连接私有对象存储。
             官方文档 https://cloud.tencent.com/document/product/436/10199 -->
        <dependency>
            <groupId>com.qcloud</groupId>
            <artifactId>cos_api</artifactId>
            <version>5.6.227</version>
        </dependency>

        <!-- Hutool 的全量工具包，提供字符串、日期和类型转换等常用 Java 工具。
             官方文档 https://plus.hutool.cn/pages/index/ -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.48</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <!-- Project Lombok 注解处理器，用于在编译主源码时处理 Lombok 注解。
                                     官方文档 https://projectlombok.org/setup/maven -->
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <!-- Project Lombok 注解处理器，用于在编译测试源码时处理 Lombok 注解。
                                     官方文档 https://projectlombok.org/setup/maven -->
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
